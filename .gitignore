# R session and project files
.Rhistory
.RData
.Ruserdata
.Rproj.user/

# Local scratch outputs
results/**
!results/.gitkeep

# Large or private data files
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.bai
*.sam
*.cram
*.crai
*.bw
*.bigWig
*.tar
*.tar.gz
*.zip

# Temporary files
.DS_Store
~$*
*.tmp
*.log

# Keep data directory documentation, but avoid accidentally committing private large inputs
/data/processed/*
!/data/processed/.gitkeep
/data/external/*
!/data/external/.gitkeep
